---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import MenuCategory from "../components/MenuCategory.astro";
import SectionHeading from "../components/SectionHeading.astro";
import GlutenFreeBadge from "../components/GlutenFreeBadge.astro";
import PizzaModal from "../components/PizzaModal.astro";
import menu from "../data/menu.json";
import site from "../data/site.json";

const categoryIds = menu.categories.map((c) => c.id);
const totalPizzas = menu.categories.reduce(
  (acc, cat) => acc + cat.items.length,
  0,
);
---

<BaseLayout
  title={`Menu Fotografico & Carta Pizze | ${site.name}`}
  description={`Scopri il menu di ${site.name}: foto zenitali dall'alto, impasti a lunga lievitazione, pizze tradizionali, le 20 regionali d'Italia e la speciale Signorpizza. Opzioni Gluten Free AIC.`}
>
  <Header slot="header" />

  <!-- Hero Section Menu -->
  <section
    class="relative overflow-hidden pt-24 pb-8 sm:pt-32 sm:pb-12 bg-gradient-to-b from-crema-forno/60 via-bianco-caldo to-bianco-caldo"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 text-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-pomodoro/10 px-3 py-1 text-[10px] sm:text-xs font-bold text-pomodoro mb-3 sm:mb-4"
      >
        Esperienza Visuale & Ricette Autentiche
      </span>
      <h1
        class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-carbone"
      >
        Il Nostro Menu
      </h1>
      <p
        class="mt-3 sm:mt-4 mx-auto max-w-2xl text-sm sm:text-lg text-grigio-caldo leading-relaxed"
      >
        Dalla classica Margherita alle 20 specialità regionali. Tocca una pizza
        per ingredienti, provenienza e abbinamenti.
      </p>

      <!-- Gluten-free highlight -->
      <div
        class="mt-4 sm:mt-6 mx-auto max-w-xl rounded-xl sm:rounded-2xl border-2 border-basilico/30 bg-gradient-to-br from-basilico/10 via-basilico/5 to-transparent px-4 py-3 sm:px-5 sm:py-4 text-left shadow-sm"
      >
        <div class="flex items-start gap-3 sm:items-center">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-basilico text-white shadow-md"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </span>
          <div>
            <p class="font-display text-base font-bold text-basilico sm:text-lg">
              Tutte le pizze disponibili senza glutine
            </p>
            <p class="mt-1 text-sm leading-relaxed text-grigio-caldo">
              Impasto certificato AIC per celiaci — stessa qualità, stessa passione.
            </p>
            <div class="mt-2">
              <GlutenFreeBadge size="md" />
            </div>
          </div>
        </div>
      </div>

      <!-- Search & Filters Container -->
      <div class="mt-5 sm:mt-8 mx-auto max-w-2xl">
        <!-- Search Input -->
        <div class="relative flex items-center shadow-sm">
          <input
            type="text"
            id="pizza-search-input"
            placeholder="Cerca pizza o ingrediente..."
            class="w-full rounded-xl sm:rounded-2xl border border-crema-forno bg-white px-4 py-3 sm:px-5 sm:py-3.5 pl-11 sm:pl-12 text-base sm:text-sm text-carbone placeholder:text-grigio-caldo/70 shadow-sm focus:border-pomodoro focus:outline-none focus:ring-2 focus:ring-pomodoro/20 transition"
          />
          <div class="pointer-events-none absolute left-3.5 sm:left-4 text-grigio-caldo">
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <button
            id="search-clear-btn"
            type="button"
            class="absolute right-3 hidden rounded-full bg-crema-forno p-1.5 text-xs text-grigio-caldo hover:text-carbone"
            aria-label="Cancella ricerca"
          >
            ✕
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- Sticky Categories Navigation -->
  <nav
    id="menu-tabs"
    class="menu-tabs sticky z-40 border-y border-crema-forno bg-bianco-caldo/95 backdrop-blur-md transition-shadow"
    aria-label="Categorie menu"
  >
    <div
      class="mx-auto flex max-w-5xl items-center justify-between gap-2 overflow-x-auto px-4 py-2.5 sm:py-3 sm:px-6 scrollbar-none"
      style="-webkit-overflow-scrolling: touch;"
    >
      <div class="flex gap-1.5 sm:gap-2">
        {
          menu.categories.map((category) => (
            <a
              href={`#${category.id}`}
              data-category={category.id}
              class="menu-tab"
            >
              {category.name}
            </a>
          ))
        }
      </div>
      <span
        id="active-results-counter"
        class="shrink-0 text-[10px] sm:text-xs font-semibold text-grigio-caldo tabular-nums"
      >
        {totalPizzas} pizze
      </span>
      <GlutenFreeBadge size="sm" class="hidden md:inline-flex shrink-0" />
    </div>
  </nav>

  <!-- Menu Cards List -->
  <main class="mx-auto max-w-5xl space-y-12 sm:space-y-16 px-4 pb-20 sm:pb-24 pt-6 sm:pt-8 sm:px-6">
    <div id="no-results-msg" class="hidden text-center py-16">
      <div
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-crema-forno text-3xl"
      >
        🔍
      </div>
      <h3 class="mt-4 font-display text-xl font-bold text-carbone">
        Nessuna pizza trovata
      </h3>
      <p class="mt-1 text-sm text-grigio-caldo">
        Prova a cercare con un altro termine o reimposta i filtri.
      </p>
      <button
        id="reset-search-btn"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-pomodoro px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-pomodoro-dark transition"
      >
        Reimposta filtri
      </button>
    </div>

    {menu.categories.map((category) => <MenuCategory category={category} />)}
  </main>

  <!-- Interactive Modal for Details & Photo Zoom -->
  <PizzaModal />

  <Footer slot="footer" />
  <StickyBar slot="sticky" />
</BaseLayout>

<script define:vars={{ categoryIds }}>
  const menuTabs = document.getElementById("menu-tabs");

  const setMenuTabsHeight = () => {
    if (!menuTabs) return;
    document.documentElement.style.setProperty(
      "--menu-tabs-height",
      `${menuTabs.offsetHeight}px`,
    );
  };

  setMenuTabsHeight();
  window.addEventListener("resize", setMenuTabsHeight, { passive: true });

  // ScrollSpy & Sticky Tabs
  const tabs = document.querySelectorAll(".menu-tab");
  const sections = categoryIds
    .map((id) => document.getElementById(id))
    .filter((section) => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const { id } = entry.target;
          tabs.forEach((tab) => {
            const active = tab.dataset.category === id;
            tab.classList.toggle("is-active", active);
            if (active) tab.setAttribute("aria-current", "true");
            else tab.removeAttribute("aria-current");
          });
        }
      });
    },
    { rootMargin: "-30% 0px -50% 0px", threshold: 0 },
  );

  sections.forEach((section) => observer.observe(section));

  tabs.forEach((tab) => {
    tab.addEventListener("click", (event) => {
      event.preventDefault();
      const target = document.getElementById(tab.dataset.category ?? "");
      target?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Interactive Card Click Handler (Open Pizza Modal)
  document.querySelectorAll(".pizza-card").forEach((card) => {
    card.addEventListener("click", () => {
      const rawData = card.getAttribute("data-pizza-info");
      if (rawData) {
        try {
          const pizzaData = JSON.parse(rawData);
          window.dispatchEvent(
            new CustomEvent("open-pizza-modal", { detail: pizzaData }),
          );
        } catch (e) {
          console.error(e);
        }
      }
    });
  });

  // Live Search Logic
  const searchInput = document.getElementById("pizza-search-input");
  const searchClearBtn = document.getElementById("search-clear-btn");
  const resetBtn = document.getElementById("reset-search-btn");
  const pizzaCards = document.querySelectorAll(".pizza-card");
  const noResults = document.getElementById("no-results-msg");
  const categorySections = document.querySelectorAll(".category-section");
  const resultsCounter = document.getElementById("active-results-counter");

  let currentQuery = "";

  function applyFilter() {
    let visibleCount = 0;

    pizzaCards.forEach((card) => {
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-description") || "";
      const reg = card.getAttribute("data-region") || "";
      const tags = card.getAttribute("data-tags") || "";

      const matchesSearch =
        !currentQuery ||
        name.includes(currentQuery) ||
        desc.includes(currentQuery) ||
        reg.includes(currentQuery) ||
        tags.toLowerCase().includes(currentQuery);

      const isVisible = matchesSearch;
      card.style.display = isVisible ? "" : "none";
      if (isVisible) visibleCount++;
    });

    // Hide empty category sections
    categorySections.forEach((section) => {
      const visibleItems = section.querySelectorAll(
        '.pizza-card:not([style*="display: none"])',
      );
      section.style.display = visibleItems.length > 0 ? "" : "none";
    });

    if (noResults) {
      noResults.classList.toggle("hidden", visibleCount > 0);
    }

    if (resultsCounter) {
      resultsCounter.textContent = `${visibleCount} pizze`;
    }

    if (searchClearBtn) {
      searchClearBtn.classList.toggle("hidden", !currentQuery);
    }
  }

  searchInput?.addEventListener("input", (e) => {
    currentQuery = e.target.value.toLowerCase().trim();
    applyFilter();
  });

  searchClearBtn?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      currentQuery = "";
      applyFilter();
      searchInput.focus();
    }
  });

  resetBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    currentQuery = "";
    applyFilter();
  });
</script>
