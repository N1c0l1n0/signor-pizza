---
import site from '../data/site.json';
---

<section class="hero-forno" aria-label="Benvenuto">
  <div class="hero-forno__media">
    <img
      src="/images/hero-forno.jpg"
      alt="Pizza napoletana sulla pala, appena uscita dal forno a legna"
      width="1536"
      height="1024"
      fetchpriority="high"
    />
  </div>
  <div class="hero-forno__shade"></div>
  <div class="hero-forno__ember" aria-hidden="true"></div>

  <div class="hero-forno__stage">
    <p class="hero-forno__kicker">Premio Le 5 Stagioni 2024 · Busto Arsizio</p>
    <h1 class="hero-forno__title">
      <span class="sr-only">{site.name}</span>
      <span class="hero-forno__line" aria-hidden="true">Signor</span>
      <span class="hero-forno__line hero-forno__line--italic" aria-hidden="true">Pizza</span>
    </h1>
    <p class="hero-forno__lead">Quarantotto ore di impasto. Poi il forno.</p>
    <div class="hero-forno__actions">
      <a href={site.bookingUrl} class="btn-primary hero-forno__cta" target="_blank" rel="noopener noreferrer">
        Prenota un tavolo
      </a>
      <a href="/menu" class="hero-forno__ghost">Scopri il menu</a>
    </div>
  </div>
</section>

<style>
  .hero-forno {
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    overflow: hidden;
    color: #f7f1e8;
    background: #0c0a08;
  }

  .hero-forno__media,
  .hero-forno__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-forno__media {
    z-index: 0;
  }

  .hero-forno__media img {
    object-fit: cover;
    object-position: 78% 42%;
    transform: scale(1.08);
    animation: hero-drift 14s ease-out forwards;
  }

  .hero-forno__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgb(12 10 8 / 0.92) 0%,
        rgb(12 10 8 / 0.62) 34%,
        rgb(12 10 8 / 0.18) 58%,
        rgb(12 10 8 / 0.05) 100%
      ),
      linear-gradient(
        180deg,
        rgb(12 10 8 / 0.28) 0%,
        transparent 28%,
        rgb(12 10 8 / 0.55) 100%
      );
  }

  .hero-forno__ember {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    height: 3px;
    background: linear-gradient(
      90deg,
      #7a1e12 0%,
      #e85d04 38%,
      #f6c177 50%,
      #e85d04 62%,
      #7a1e12 100%
    );
    box-shadow: 0 0 28px 6px rgb(232 93 4 / 0.4);
  }

  .hero-forno__stage {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    justify-content: flex-end;
    padding: 7.5rem clamp(1.25rem, 5vw, 5rem) 7rem;
  }

  .hero-forno__kicker,
  .hero-forno__title,
  .hero-forno__lead,
  .hero-forno__actions {
    animation: hero-rise 0.9s ease-out both;
  }

  .hero-forno__kicker {
    margin-bottom: 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f6c177;
    max-width: 22rem;
    animation-delay: 0.15s;
  }

  .hero-forno__title {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 12vw, 7.25rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.03em;
    animation-delay: 0.28s;
  }

  .hero-forno__line {
    display: block;
  }

  .hero-forno__line--italic {
    font-style: italic;
    font-weight: 700;
    color: #fffbf5;
  }

  .hero-forno__lead {
    margin-top: 1.25rem;
    max-width: 22rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    color: #fffbf5;
    animation-delay: 0.42s;
  }

  .hero-forno__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    animation-delay: 0.54s;
  }

  .hero-forno__cta {
    box-shadow: 0 10px 30px rgb(192 57 43 / 0.35);
  }

  .hero-forno__ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fffbf5;
    box-shadow: inset 0 0 0 1px rgb(255 251 245 / 0.4);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .hero-forno__ghost:hover {
    background: rgb(255 251 245 / 0.12);
  }

  @keyframes hero-drift {
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 639px) {
    .hero-forno__shade {
      background:
        linear-gradient(
          180deg,
          rgb(12 10 8 / 0.45) 0%,
          rgb(12 10 8 / 0.12) 28%,
          rgb(12 10 8 / 0.82) 100%
        );
    }

    .hero-forno__media img {
      object-position: 68% 46%;
    }
  }

  @media (min-width: 640px) {
    .hero-forno__stage {
      padding-bottom: 5.5rem;
    }

    .hero-forno__media img {
      object-position: 82% 44%;
    }
  }

  @media (min-width: 1024px) {
    .hero-forno__stage {
      justify-content: center;
      padding-top: 6rem;
      padding-bottom: 5rem;
    }

    .hero-forno__media img {
      object-position: 88% 46%;
    }

    .hero-forno__shade {
      background:
        linear-gradient(
          90deg,
          rgb(12 10 8 / 0.94) 0%,
          rgb(12 10 8 / 0.7) 28%,
          rgb(12 10 8 / 0.22) 52%,
          transparent 72%
        ),
        linear-gradient(
          180deg,
          rgb(12 10 8 / 0.22) 0%,
          transparent 36%,
          rgb(12 10 8 / 0.28) 100%
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-forno__media img,
    .hero-forno__kicker,
    .hero-forno__title,
    .hero-forno__lead,
    .hero-forno__actions {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
