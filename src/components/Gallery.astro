---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import salaCompleta from '../assets/gallery/sala-completa.jpg';
import muralePizzaiolo from '../assets/gallery/murale-pizzaiolo.jpg';
import salaFinestre from '../assets/gallery/sala-finestre.jpg';
---

<section id="galleria" class="section-padding section-alt">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-10 sm:mb-12">
      <SectionHeading
        label="Galleria"
        title="La sala, prima del servizio"
        description="Mattoni a vista, parquet e le finestre ad arco che accendono di rosso la parete di legno."
        align="center"
      />
    </div>

    <div class="gallery-bento">
      <figure class="gallery-cell gallery-cell--hero reveal" style="--reveal-delay: 0ms">
        <Image
          src={salaCompleta}
          alt="La sala principale di Signor Pizza con tavoli apparecchiati, parete in mattoni a vista e pavimento in legno"
          widths={[480, 640, 768, 960, 1200, 1400]}
          sizes="(max-width: 767px) 100vw, (max-width: 1023px) 66vw, 720px"
          class="gallery-photo"
          style="object-position: center 38%;"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="gallery-cell gallery-cell--win reveal" style="--reveal-delay: 90ms">
        <Image
          src={salaFinestre}
          alt="Le finestre ad arco illuminate di rosso nella sala, con la luce del sole sul pavimento"
          widths={[320, 400, 480, 640, 900]}
          sizes="(max-width: 767px) 100vw, (max-width: 1023px) 42vw, 444px"
          class="gallery-photo"
          style="object-position: center 50%;"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <a href="#contatti" class="gallery-arch reveal" style="--reveal-delay: 180ms">
        <span class="gallery-arch__light" aria-hidden="true"></span>
        <span class="gallery-arch__label">Prenotazione consigliata</span>
        <p class="gallery-arch__line">Premi per gli orari</p>
        <span class="gallery-arch__cta">
          Prenota
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>

      <figure class="gallery-cell gallery-cell--tall reveal" style="--reveal-delay: 270ms">
        <Image
          src={muralePizzaiolo}
          alt="Il murale dipinto sopra i tavoli, sulla parete di fondo della sala"
          widths={[240, 300, 360, 405]}
          sizes="(max-width: 767px) 100vw, 33vw"
          class="gallery-photo"
          style="object-position: center 42%;"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .gallery-bento {
    --gallery-gap: 12px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gallery-gap);
  }

  .gallery-cell,
  .gallery-arch {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
  }

  .gallery-cell {
    background-color: var(--color-carbone);
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* Mobile: every photo keeps a ratio close to its own frame. */
  .gallery-cell--hero {
    aspect-ratio: 4 / 3;
  }

  .gallery-cell--win {
    aspect-ratio: 1 / 1;
  }

  .gallery-cell--tall {
    aspect-ratio: 3 / 4;
  }

  .gallery-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(26 26 26 / 0.08);
    pointer-events: none;
  }

  .gallery-cell:hover .gallery-photo {
    transform: scale(1.04);
  }

  /* The signature cell: the room's red arched windows, rendered as a card. */
  .gallery-arch {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem;
    text-align: center;
    background-color: var(--color-pomodoro);
    border-radius: 999px 999px 14px 14px;
    max-width: 22rem;
    min-height: 17rem;
    margin-inline: auto;
    width: 100%;
    text-decoration: none;
    /*
      Longhands, not a shorthand: `.reveal` supplies the fade-in transition on
      this same element, so a `transition` shorthand here would replace it and
      make the card snap in. The hover colour keeps a 0ms delay while the
      reveal properties carry the stagger.
    */
    transition-property: opacity, translate, transform, background-color;
    transition-duration: 700ms, 700ms, 700ms, 300ms;
    transition-timing-function: ease-out, ease-out, ease-out, ease;
    transition-delay: var(--reveal-delay, 0ms), var(--reveal-delay, 0ms),
      var(--reveal-delay, 0ms), 0ms;
  }

  .gallery-arch:hover {
    background-color: var(--color-pomodoro-dark);
  }

  .gallery-arch:focus-visible {
    outline-color: var(--color-bianco-caldo);
  }

  .gallery-arch__light {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: var(--color-bianco-caldo);
    box-shadow: 0 0 0 6px rgb(255 251 245 / 0.14), 0 0 22px 6px rgb(255 251 245 / 0.35);
  }

  .gallery-arch__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 251 245 / 0.9);
  }

  .gallery-arch__line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.3;
    color: var(--color-bianco-caldo);
    text-wrap: balance;
  }

  .gallery-arch__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-bianco-caldo);
  }

  .gallery-arch__cta svg {
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-arch:hover .gallery-arch__cta svg {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .gallery-bento {
      --gallery-gap: 16px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1.3fr 1fr;
      grid-template-areas:
        'hero hero hero hero hero hero hero hero tall tall tall tall'
        'win  win  win  win  win  arch arch arch tall tall tall tall';
      aspect-ratio: 3 / 2;
    }

    /* Cells fill their track, so ratios come from the grid itself. */
    .gallery-cell--hero,
    .gallery-cell--win,
    .gallery-cell--tall {
      aspect-ratio: auto;
    }

    .gallery-cell--hero {
      grid-area: hero;
    }

    .gallery-cell--win {
      grid-area: win;
    }

    .gallery-cell--tall {
      grid-area: tall;
    }

    .gallery-arch {
      grid-area: arch;
      max-width: none;
      min-height: 0;
      padding: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-bento {
      aspect-ratio: 16 / 10;
    }

    .gallery-arch {
      padding: 1.5rem;
      gap: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-photo,
    .gallery-arch,
    .gallery-arch__cta svg {
      transition: none;
    }

    .gallery-cell:hover .gallery-photo,
    .gallery-arch:hover .gallery-arch__cta svg {
      transform: none;
    }

    .gallery-cell,
    .gallery-arch {
      --reveal-delay: 0ms;
    }
  }
</style>
