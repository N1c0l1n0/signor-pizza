---
// PizzaModal.astro - Interactive modal for high-res pizza exploration
---

<div
  id="pizza-modal"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-all duration-300 backdrop-blur-md bg-carbone/60"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="modal-title"
>
  <div
    id="modal-card"
    class="modal-card relative flex w-full max-w-2xl max-h-[88dvh] sm:max-h-[90dvh] flex-col bg-white shadow-2xl border border-crema-forno sm:border overflow-hidden"
  >
    <!-- Mobile drag handle + close -->
    <div class="relative shrink-0 flex items-center justify-center px-4 pt-3 pb-1 sm:pt-0 sm:pb-0 sm:absolute sm:top-4 sm:right-4 sm:z-10 sm:justify-end">
      <div class="absolute top-2 left-1/2 -translate-x-1/2 h-1 w-10 rounded-full bg-crema-forno sm:hidden" aria-hidden="true"></div>
      <button
        id="modal-close-btn"
        type="button"
        class="ml-auto flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-crema-forno text-carbone hover:bg-pomodoro hover:text-white transition shadow-sm focus:outline-none touch-manipulation"
        aria-label="Chiudi dettaglio pizza"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Scrollable content -->
    <div id="modal-scroll" class="flex-1 overflow-y-auto overscroll-contain px-4 pb-5 pt-1 sm:p-8 sm:pt-8">
      <div class="grid gap-4 sm:gap-6 sm:grid-cols-12 sm:items-start">
        <!-- Pizza visual + compact header on mobile -->
        <div class="sm:col-span-5">
          <div class="flex items-start gap-4 sm:flex-col sm:items-center">
            <div class="relative group shrink-0 w-24 h-24 sm:w-56 sm:h-56">
              <div class="absolute inset-0 rounded-full bg-forno-arancio/15 blur-xl sm:blur-2xl transform transition duration-500"></div>
              <img
                id="modal-pizza-img"
                src=""
                alt=""
                class="relative h-full w-full object-cover rounded-full shadow-xl sm:shadow-2xl select-none"
                loading="lazy"
              />
            </div>

            <div class="min-w-0 flex-1 sm:hidden">
              <span id="modal-category-tag-mobile" class="text-[10px] font-bold uppercase tracking-wider text-pomodoro"></span>
              <h3 id="modal-title-mobile" class="mt-0.5 font-display text-xl font-semibold text-carbone leading-tight"></h3>
              <div class="mt-1.5 flex items-baseline gap-2">
                <span id="modal-price-mobile" class="font-display text-xl font-bold tabular-nums text-pomodoro"></span>
              </div>
            </div>
          </div>
          <span id="modal-region-tag" class="mt-2 hidden sm:block text-center text-xs font-semibold uppercase tracking-widest text-basilico"></span>
        </div>

        <!-- Content -->
        <div class="sm:col-span-7 flex flex-col sm:pr-2">
          <div class="hidden sm:block">
            <span id="modal-category-tag" class="text-xs font-bold uppercase tracking-wider text-pomodoro"></span>
            <h3 id="modal-title" class="mt-1 font-display text-2xl sm:text-3xl font-semibold text-carbone"></h3>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-grigio-caldo">Prezzo</span>
              <span id="modal-price" class="font-display text-2xl font-bold tabular-nums text-pomodoro"></span>
            </div>
          </div>

          <!-- Tags row -->
          <div id="modal-tags" class="flex flex-wrap gap-1.5 sm:mt-2"></div>

          <!-- Ingredients (description shown as pills — no duplicate text block) -->
          <div class="mt-3 sm:mt-4">
            <h4 class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-carbone/70">Ingredienti</h4>
            <div id="modal-ingredients" class="mt-1.5 sm:mt-2 flex flex-wrap gap-1.5"></div>
          </div>

          <!-- Sommelier Pairing Box -->
          <div class="mt-4 sm:mt-5 rounded-xl sm:rounded-2xl bg-crema-forno/70 p-3 sm:p-3.5 border border-crema-forno">
            <div class="flex items-center gap-2 text-[10px] sm:text-xs font-bold text-basilico">
              <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              Abbinamento consigliato
            </div>
            <p id="modal-pairing-beverage" class="mt-1 text-xs font-semibold text-carbone leading-snug"></p>
            <p id="modal-pairing-note" class="mt-0.5 text-[11px] sm:text-xs text-grigio-caldo leading-relaxed line-clamp-3 sm:line-clamp-none"></p>
          </div>

          <!-- Gluten-free callout — compact on mobile -->
          <div class="mt-3 sm:mt-4 flex items-center gap-2.5 sm:items-start sm:gap-3 rounded-xl sm:rounded-2xl border border-basilico/25 bg-basilico/8 px-3 py-2.5 sm:px-4 sm:py-3">
            <span class="flex h-7 w-7 sm:h-8 sm:w-8 shrink-0 items-center justify-center rounded-full bg-basilico text-white">
              <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-basilico">Disponibile senza glutine</p>
              <p class="hidden sm:block mt-0.5 text-xs leading-relaxed text-grigio-caldo">
                Impasto certificato AIC, preparato con attenzione dedicata per celiaci.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-card {
    border-radius: 1.5rem 1.5rem 0 0;
    transform: translateY(1rem);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  @media (min-width: 640px) {
    .modal-card {
      border-radius: 1.5rem;
      transform: scale(0.95);
    }
  }

  #pizza-modal.is-open .modal-card {
    transform: translateY(0);
    opacity: 1;
  }

  @media (min-width: 640px) {
    #pizza-modal.is-open .modal-card {
      transform: scale(1);
    }
  }
</style>

<script>
  const modal = document.getElementById('pizza-modal');
  const modalCard = document.getElementById('modal-card');
  const modalScroll = document.getElementById('modal-scroll');
  const closeBtn = document.getElementById('modal-close-btn');

  const modalImg = document.getElementById('modal-pizza-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalTitleMobile = document.getElementById('modal-title-mobile');
  const modalPrice = document.getElementById('modal-price');
  const modalPriceMobile = document.getElementById('modal-price-mobile');
  const modalCat = document.getElementById('modal-category-tag');
  const modalCatMobile = document.getElementById('modal-category-tag-mobile');
  const modalRegion = document.getElementById('modal-region-tag');
  const modalTags = document.getElementById('modal-tags');
  const modalIngredients = document.getElementById('modal-ingredients');
  const modalPairingBev = document.getElementById('modal-pairing-beverage');
  const modalPairingNote = document.getElementById('modal-pairing-note');

  function setText(el: HTMLElement | null, text: string) {
    if (el) el.textContent = text;
  }

  function openModal(data: any) {
    if (!modal || !modalCard) return;

    const category = data.category || 'Specialità';
    const price = `€ ${Number(data.price).toFixed(2)}`;
    const region = data.region ? `Origine: ${data.region}` : 'Tradizione Napoletana';

    if (modalImg) {
      modalImg.src = data.image || '/images/pizze/margherita.jpg';
      modalImg.alt = `Foto dall'alto di ${data.name}`;
    }

    setText(modalTitle, data.name);
    setText(modalTitleMobile, data.name);
    setText(modalPrice, price);
    setText(modalPriceMobile, price);
    setText(modalCat, category);
    setText(modalCatMobile, category);
    setText(modalRegion, region);

    if (modalTags) {
      modalTags.innerHTML = '';
      if (data.tags && Array.isArray(data.tags)) {
        data.tags.forEach((tag: string) => {
          const span = document.createElement('span');
          span.className = 'rounded-full bg-pomodoro/10 px-2 py-0.5 text-[10px] sm:text-xs font-semibold text-pomodoro';
          span.textContent = tag;
          modalTags.appendChild(span);
        });
      }
      if (data.featured) {
        const span = document.createElement('span');
        span.className = 'rounded-full bg-basilico/10 px-2 py-0.5 text-[10px] sm:text-xs font-semibold text-basilico';
        span.textContent = '★ Consigliato';
        modalTags.appendChild(span);
      }
    }

    if (modalIngredients) {
      modalIngredients.innerHTML = '';
      const ingredients = (data.description || '').split(',').map((s: string) => s.trim()).filter(Boolean);
      ingredients.forEach((ing: string) => {
        const span = document.createElement('span');
        span.className = 'rounded-lg bg-crema-forno px-2 py-0.5 sm:px-2.5 sm:py-1 text-[11px] sm:text-xs font-medium text-carbone';
        span.textContent = ing;
        modalIngredients.appendChild(span);
      });
    }

    if (modalPairingBev) modalPairingBev.textContent = data.pairingBev || 'Birra Artigianale Signor Pizza o Falanghina DOC';
    if (modalPairingNote) modalPairingNote.textContent = data.pairingNote || 'Abbinamento consigliato per valorizzare al meglio l\'impasto e i condimenti freschi.';

    modalScroll?.scrollTo(0, 0);

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto', 'is-open');
    modal.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeModal() {
    if (!modal || !modalCard) return;

    modal.classList.remove('opacity-100', 'pointer-events-auto', 'is-open');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.setAttribute('aria-hidden', 'true');

    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  window.addEventListener('open-pizza-modal', ((e: CustomEvent) => {
    openModal(e.detail);
  }) as EventListener);
</script>
