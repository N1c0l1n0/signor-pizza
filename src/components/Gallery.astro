---
import SectionHeading from './SectionHeading.astro';

const photos = [
  { src: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=700&q=80', alt: 'Sala della pizzeria' },
  { src: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=700&q=80', alt: 'Pizza gourmet con ingredienti freschi' },
  { src: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=700&q=80', alt: 'Bancone e area bar' },
  { src: 'https://images.unsplash.com/photo-1571997478779-2adcbbe9ab2f?auto=format&fit=crop&w=700&q=80', alt: 'Pizza margherita appena sfornata' },
  { src: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=700&q=80', alt: 'Tavoli apparecchiati per la cena' },
  { src: 'https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&w=700&q=80', alt: 'Dettaglio del forno' },
];
---

<section id="galleria" class="section-padding section-alt">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12">
      <SectionHeading
        label="Galleria"
        title="Atmosfera e piatti"
        description="Un assaggio visivo del locale e delle nostre creazioni."
        align="center"
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((photo, index) => (
        <figure class:list={['reveal group overflow-hidden rounded-2xl', index === 0 && 'sm:col-span-2 sm:row-span-2']}>
          <img
            src={photo.src}
            alt={photo.alt}
            width="700"
            height={index === 0 ? 560 : 280}
            class:list={[
              'w-full object-cover transition duration-500 group-hover:scale-105',
              index === 0 ? 'h-72 sm:h-full sm:min-h-[420px]' : 'h-56',
            ]}
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
