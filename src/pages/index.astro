---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Awards from '../components/Awards.astro';
import FeaturedDishes from '../components/FeaturedDishes.astro';
import Services from '../components/Services.astro';
import VenueAttributes from '../components/VenueAttributes.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout>
  <Header slot="header" />
  <Hero />
  <About />
  <Awards />
  <FeaturedDishes />
  <Services />
  <VenueAttributes />
  <Gallery />
  <Contact />
  <Footer slot="footer" />
  <StickyBar slot="sticky" />
</BaseLayout>
