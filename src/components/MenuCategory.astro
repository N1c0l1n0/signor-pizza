---
import MenuItem from './MenuItem.astro';
import type { MenuCategory } from '../types/content';

interface Props {
  category: MenuCategory;
}

const { category } = Astro.props;
---

<section id={category.id} class="category-section scroll-mt-28 sm:scroll-mt-36">
  <div class="mb-4 sm:mb-6 flex items-end justify-between border-b border-crema-forno pb-2.5 sm:pb-3">
    <div>
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-pomodoro">Categoria</span>
      <h2 class="font-display text-xl sm:text-3xl font-bold text-carbone">{category.name}</h2>
    </div>
    <span class="rounded-full bg-crema-forno px-2.5 py-0.5 sm:px-3 sm:py-1 text-[10px] sm:text-xs font-semibold text-grigio-caldo">
      {category.items.length} pizze
    </span>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {category.items.map((item) => (
      <MenuItem item={item} categoryName={category.name} />
    ))}
  </div>
</section>
