---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showAic?: boolean;
  class?: string;
}

const { size = 'sm', showAic = true, class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'px-2.5 py-0.5 text-[11px] gap-1',
  md: 'px-3 py-1 text-xs gap-1.5',
  lg: 'px-4 py-2 text-sm gap-2',
};

const iconSizes = {
  sm: 'h-3 w-3',
  md: 'h-3.5 w-3.5',
  lg: 'h-4 w-4',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full bg-basilico/12 font-bold text-basilico ring-1 ring-basilico/25',
    sizeClasses[size],
    className,
  ]}
>
  <svg
    class={iconSizes[size]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
    />
  </svg>
  Senza glutine{showAic && <span class="font-semibold opacity-80"> · AIC</span>}
</span>
