---
import SectionHeading from './SectionHeading.astro';

const services = [
  {
    title: 'Asporto',
    text: 'Ordina e ritira in pizzeria, pronto quando arrivi.',
    icon: `<path d="M16 16h6v6H16zM2 16h6v6H2zM9 2v6H3V2zM21 2v6h-6V2zM9 16v6H3v-6zM21 16v6h-6v-6zM16 2v6h-6V2z"/>`,
  },
  {
    title: 'Consegna a domicilio',
    text: 'Pizza a casa tua, anche con consegna senza contatto.',
    icon: `<path d="M10 17h4V5H2v12h3M15 17h2l3-3V8h-5v9z"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>`,
  },
  {
    title: 'Consumazione sul posto',
    text: 'Servizio al tavolo in un ambiente casual e accogliente.',
    icon: `<path d="M3 11h18M5 11V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4M7 19v2M17 19v2M3 11v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4"/>`,
  },
  {
    title: 'Prenotazioni',
    text: 'Consigliata la prenotazione per la cena del weekend.',
    icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>`,
  },
];
---

<section id="servizi" class="section-padding section-alt">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12">
      <SectionHeading
        label="Servizi"
        title="Come possiamo servirti"
        description="Pranzo, cena o asporto — scegli la formula che preferisci."
        align="center"
      />
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <article class="reveal rounded-2xl bg-bianco-caldo p-6 shadow-sm">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-basilico/10 text-basilico">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" set:html={service.icon} />
          </div>
          <h3 class="font-display text-lg font-semibold text-carbone">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-grigio-caldo">{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
