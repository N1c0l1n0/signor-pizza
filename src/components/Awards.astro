---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';
---

<section id="riconoscimenti" class="section-padding section-alt">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12">
      <SectionHeading
        label="Riconoscimenti"
        title="Premi e certificazioni"
        description="Qualità riconosciuta a livello nazionale, con attenzione anche alla ristorazione gluten free."
        align="center"
      />
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {site.awards.map((award, index) => (
        <article class="reveal rounded-2xl border border-crema-forno bg-bianco-caldo p-6 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-crema-forno text-basilico">
            {index === 0 && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM5 4H3v2a4 4 0 0 0 4 4M19 4h2v2a4 4 0 0 1-4 4"/>
              </svg>
            )}
            {index === 1 && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
            )}
            {index === 2 && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            )}
          </div>
          <h3 class="font-display text-xl font-semibold text-carbone">
            {award.title}
            {award.year && <span class="block text-sm font-body font-semibold text-pomodoro">{award.year}</span>}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-grigio-caldo">{award.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
