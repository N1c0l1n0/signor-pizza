---
// PizzaModal.astro - Interactive modal for high-res pizza exploration
---

<div
  id="pizza-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 backdrop-blur-md bg-carbone/60"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div
    id="modal-card"
    class="relative w-full max-w-2xl transform scale-95 opacity-0 transition-all duration-300 rounded-3xl bg-white p-6 sm:p-8 shadow-2xl border border-crema-forno overflow-hidden"
  >
    <!-- Close Button -->
    <button
      id="modal-close-btn"
      type="button"
      class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-crema-forno text-carbone hover:bg-pomodoro hover:text-white transition shadow-sm focus:outline-none"
      aria-label="Chiudi dettaglio pizza"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid gap-6 sm:grid-cols-12 items-center">
      <!-- Pizza Top-down Visual -->
      <div class="sm:col-span-5 flex flex-col items-center justify-center">
        <div class="relative group w-48 h-48 sm:w-56 sm:h-56">
          <!-- Ambient Glow/Shadow -->
          <div class="absolute inset-0 rounded-full bg-forno-arancio/15 blur-2xl transform group-hover:scale-110 transition duration-500"></div>
          
          <img
            id="modal-pizza-img"
            src=""
            alt=""
            class="relative h-full w-full object-cover rounded-full shadow-2xl transform transition duration-500 group-hover:scale-105 group-hover:rotate-6 select-none"
            loading="lazy"
          />
        </div>
        <span id="modal-region-tag" class="mt-3 text-xs font-semibold uppercase tracking-widest text-basilico"></span>
      </div>

      <!-- Content (pr-14 keeps text clear of the absolute close button) -->
      <div class="sm:col-span-7 flex flex-col justify-between pr-14">
        <div>
          <span id="modal-category-tag" class="text-xs font-bold uppercase tracking-wider text-pomodoro"></span>

          <h3 id="modal-title" class="mt-1 font-display text-2xl sm:text-3xl font-semibold text-carbone"></h3>

          <div class="mt-2 flex items-baseline gap-2">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-grigio-caldo">Prezzo</span>
            <span id="modal-price" class="font-display text-2xl font-bold tabular-nums text-pomodoro"></span>
          </div>

          <!-- Tags row -->
          <div id="modal-tags" class="mt-2 flex flex-wrap gap-1.5"></div>

          <!-- Description -->
          <p id="modal-desc" class="mt-3 text-sm leading-relaxed text-grigio-caldo"></p>

          <!-- Ingredients Pill Grid -->
          <div class="mt-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-carbone/70">Ingredienti principali:</h4>
            <div id="modal-ingredients" class="mt-2 flex flex-wrap gap-1.5"></div>
          </div>
        </div>

        <!-- Sommelier Pairing Box -->
        <div class="mt-5 rounded-2xl bg-crema-forno/70 p-3.5 border border-crema-forno">
          <div class="flex items-center gap-2 text-xs font-bold text-basilico">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            Abbinamento Consigliato
          </div>
          <p id="modal-pairing-beverage" class="mt-1 text-xs font-semibold text-carbone"></p>
          <p id="modal-pairing-note" class="text-xs text-grigio-caldo"></p>
        </div>

        <!-- Gluten-free callout -->
        <div class="mt-4 flex items-start gap-3 rounded-2xl border border-basilico/25 bg-basilico/8 px-4 py-3">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-basilico text-white">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </span>
          <div>
            <p class="text-sm font-bold text-basilico">Disponibile senza glutine</p>
            <p class="mt-0.5 text-xs leading-relaxed text-grigio-caldo">
              Impasto certificato AIC, preparato con attenzione dedicata per celiaci.
            </p>
          </div>
        </div>

        <p class="mt-3 text-right text-xs italic text-grigio-caldo font-display">Signor Pizza · 2026</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Client logic for Pizza modal
  const modal = document.getElementById('pizza-modal');
  const modalCard = document.getElementById('modal-card');
  const closeBtn = document.getElementById('modal-close-btn');

  const modalImg = document.getElementById('modal-pizza-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalPrice = document.getElementById('modal-price');
  const modalDesc = document.getElementById('modal-desc');
  const modalCat = document.getElementById('modal-category-tag');
  const modalRegion = document.getElementById('modal-region-tag');
  const modalTags = document.getElementById('modal-tags');
  const modalIngredients = document.getElementById('modal-ingredients');
  const modalPairingBev = document.getElementById('modal-pairing-beverage');
  const modalPairingNote = document.getElementById('modal-pairing-note');

  function openModal(data: any) {
    if (!modal || !modalCard) return;

    if (modalImg) {
      modalImg.src = data.image || '/images/pizze/margherita.jpg';
      modalImg.alt = `Foto dall'alto di ${data.name}`;
    }
    if (modalTitle) modalTitle.textContent = data.name;
    if (modalPrice) modalPrice.textContent = `€ ${Number(data.price).toFixed(2)}`;
    if (modalDesc) modalDesc.textContent = data.description;
    if (modalCat) modalCat.textContent = data.category || 'Specialità';
    if (modalRegion) modalRegion.textContent = data.region ? `Origine: ${data.region}` : 'Tradizione Napoletana';

    if (modalTags) {
      modalTags.innerHTML = '';
      const gfBadge = document.createElement('span');
      gfBadge.className = 'inline-flex items-center gap-1 rounded-full bg-basilico/12 px-2.5 py-0.5 text-xs font-bold text-basilico ring-1 ring-basilico/25';
      gfBadge.textContent = 'Senza glutine · AIC';
      modalTags.appendChild(gfBadge);
      if (data.tags && Array.isArray(data.tags)) {
        data.tags.forEach((tag: string) => {
          const span = document.createElement('span');
          span.className = 'rounded-full bg-pomodoro/10 px-2.5 py-0.5 text-xs font-semibold text-pomodoro';
          span.textContent = tag;
          modalTags.appendChild(span);
        });
      }
      if (data.featured) {
        const span = document.createElement('span');
        span.className = 'rounded-full bg-basilico/10 px-2.5 py-0.5 text-xs font-semibold text-basilico';
        span.textContent = '★ Consigliato';
        modalTags.appendChild(span);
      }
    }

    if (modalIngredients) {
      modalIngredients.innerHTML = '';
      const ingredients = (data.description || '').split(',').map((s: string) => s.trim()).filter(Boolean);
      ingredients.forEach((ing: string) => {
        const span = document.createElement('span');
        span.className = 'rounded-lg bg-crema-forno px-2.5 py-1 text-xs font-medium text-carbone';
        span.textContent = ing;
        modalIngredients.appendChild(span);
      });
    }

    if (modalPairingBev) modalPairingBev.textContent = data.pairingBev || 'Birra Artigianale Signor Pizza o Falanghina DOC';
    if (modalPairingNote) modalPairingNote.textContent = data.pairingNote || 'Abbinamento consigliato per valorizzare al meglio l\'impasto e i condimenti freschi.';

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    modal.setAttribute('aria-hidden', 'false');

    modalCard.classList.remove('scale-95', 'opacity-0');
    modalCard.classList.add('scale-100', 'opacity-100');

    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalCard) return;

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.setAttribute('aria-hidden', 'true');

    modalCard.classList.remove('scale-100', 'opacity-100');
    modalCard.classList.add('scale-95', 'opacity-0');

    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Attach global listener for custom event or triggers
  window.addEventListener('open-pizza-modal', ((e: CustomEvent) => {
    openModal(e.detail);
  }) as EventListener);
</script>
