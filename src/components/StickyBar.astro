---
import site from '../data/site.json';
import { telHref } from '../utils/format';
---

<div
  id="sticky-bar"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-crema-forno bg-bianco-caldo/95 backdrop-blur-md lg:hidden"
  aria-label="Azioni rapide"
>
  <div class="grid grid-cols-3 divide-x divide-crema-forno">
    <a
      href={telHref(site.phone)}
      class="flex flex-col items-center gap-1 px-2 py-3 text-xs font-semibold text-carbone"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Chiama
    </a>
    <a href="/menu" class="flex flex-col items-center gap-1 px-2 py-3 text-xs font-semibold text-pomodoro">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      Menu
    </a>
    <a
      href={site.bookingUrl}
      class="flex flex-col items-center gap-1 px-2 py-3 text-xs font-semibold text-basilico"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Prenota
    </a>
  </div>
</div>

<style>
  @media (max-width: 1023px) {
    body {
      padding-bottom: 4.5rem;
    }
  }
</style>
