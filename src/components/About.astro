---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';
---

<section id="chi-siamo" class="section-padding">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <SectionHeading
          label="Chi siamo"
          title="Tradizione napoletana, spirito gourmet"
          description={site.about.lead}
        />
        <div class="mt-6 space-y-4 text-base leading-relaxed text-grigio-caldo">
          {site.about.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <div class="reveal grid gap-4 sm:grid-cols-2">
        <div class="overflow-hidden rounded-2xl sm:col-span-2">
          <img
            src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=900&q=80"
            alt="Pizzaiolo che stende l'impasto"
            width="900"
            height="500"
            class="h-56 w-full object-cover sm:h-72"
            loading="lazy"
          />
        </div>
        {site.about.values.map((value) => (
          <article class="rounded-2xl bg-crema-forno p-5">
            <h3 class="font-display text-lg font-semibold text-carbone">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-grigio-caldo">{value.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
